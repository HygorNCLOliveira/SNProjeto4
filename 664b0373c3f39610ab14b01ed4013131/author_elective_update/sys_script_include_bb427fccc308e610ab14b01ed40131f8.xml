    <sys_script_include action="DELETE">
        <access>public</access>
        <active>false</active>
        <api_name>x_1593182_bases.BaseManagerHandler</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description>This automation assigns the role of manager to the user filled in in the manager field, and subtracts a vacancy from the base capacity number.</description>
        <mobile_callable>false</mobile_callable>
        <name>BaseManagerHandler</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var BaseManagerHandler = Class.create();
BaseManagerHandler.prototype = Object.extendsObject(AbstractAjaxProcessor, {
	
    processarBase: function() {

		var manager = this.getParameter('sysparm_name');
		var baseName = this.getParameter('sysparm_base');

		if (!manager || !baseName) {
            return 'Erro: Manager ou Base não informados corretamente.';
        }

        var baseGR = new GlideRecord('x_1593182_bases_base');
        baseGR.addQuery('name', baseName);
        baseGR.query();

        if (baseGR.next()) {
            if (baseGR.capacity > 0) {
                baseGR.capacity -= 1;
                baseGR.update();

                var linkRequestGR = new GlideRecord('x_1593182_bases_link_request');
                linkRequestGR.initialize();
                linkRequestGR.created_by = manager;
                linkRequestGR.base = baseName;
                linkRequestGR.state = 3;
                linkRequestGR.insert();

                return 'Gerente vinculado com sucesso!';

			} else {
                return 'Erro: Capacidade máxima atingida!';
            }
        } else {
            return 'Erro: Base não encontrada!';
        }
    },

    type: 'BaseManagerHandler'
});]]></script>
