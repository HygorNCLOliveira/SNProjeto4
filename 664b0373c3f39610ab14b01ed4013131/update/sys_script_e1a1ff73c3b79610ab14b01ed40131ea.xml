        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Name field validation
    var baseCheck = new GlideRecord('x_1593182_bases_base');
    baseCheck.addQuery('name', current.name);
    baseCheck.query();

    if (baseCheck.next()) {
        gs.addErrorMessage('Já existe uma base cadastrada com este nome.');
        current.setAbortAction(true);
        return;
    }

    // city and state validation
    var locationCheck = new GlideRecord('x_1593182_bases_base');
    locationCheck.addQuery('city', current.city); // Campo de cidade
    locationCheck.addQuery('state', current.state); // Campo de estado
    locationCheck.query();

    if (locationCheck.next()) {
        gs.addErrorMessage('Já existe uma base cadastrada nesta cidade e estado.');
        current.setAbortAction(true);
        return;
    }

})(current, previous);]]></script>
